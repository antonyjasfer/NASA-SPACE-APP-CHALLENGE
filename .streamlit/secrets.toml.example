# Copy to .streamlit/secrets.toml (git-ignored) or set as env vars / Streamlit Cloud secrets.
# Never commit real keys.

# Meta (primary). api.meta.ai uses the OpenAI-compatible Responses API.
MODEL_API_KEY = ""                       # META_API_KEY or a [meta] section (api_key/base_url/model) also work
META_BASE_URL = "https://api.meta.ai/v1" # default if unset
META_MODEL = "muse-wonder-1.0"           # default if unset
META_API_STYLE = "responses"             # "responses" or "chat"; if unset, llama.com URLs use "chat", others "responses"
                                         # (chat: e.g. META_BASE_URL="https://api.llama.com/compat/v1/")

# NVIDIA NIM (optional fallback, chat completions). Used only if all three are set.
NVIDIA_API_KEY = ""
NVIDIA_BASE_URL = "https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL = "meta/llama-3.3-70b-instruct"
